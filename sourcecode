        "message " +
        (
            success
            ?
            "success"
            :
            "error"
        );
}


/* =====================================================
   AUDIT LOG
===================================================== */

function addAudit(
    text,
    success = true
) {

    const audit =
        document.getElementById(
            "auditLog"
        );

    if (!audit) return;

    const item =
        document.createElement(
            "div"
        );

    item.className =
        success
        ?
        "audit success-log"
        :
        "audit error-log";

    item.innerHTML =

        "<strong>" +
        escapeHTML(text) +
        "</strong>" +

        "<br>" +

        "<small>" +
        new Date().toLocaleString() +
        "</small>";

    audit.prepend(item);
}


/* =====================================================
   HTML ESCAPING
===================================================== */

function escapeHTML(value) {

    return String(value)

        .replace(
            /&/g,
            "&amp;"
        )

        .replace(
            /</g,
            "&lt;"
        )

        .replace(
            />/g,
            "&gt;"
        )

        .replace(
            /"/g,
            "&quot;"
        )

        .replace(
            /'/g,
            "&#039;"
        );
}

