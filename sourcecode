/* =====================================================
   DOWNLOAD SPECIFIC RECORD
===================================================== */

function downloadSelectedSpecific(recordId) {

    selectedRecordId = recordId;

    downloadRecordById(recordId);
}


/* =====================================================
   DOWNLOAD FUNCTION
===================================================== */

function downloadRecordById(recordId) {

    const record =
        sharedRecords.find(
            r => r.recordId === recordId
        );

    if (!record) {

        showMessage(
            "downloadMessage",
            "Record not found.",
            false
        );

        return;
    }

    if (
        currentUser.role === "doctor" &&
        (
            record.sharedWithDoctorId !==
            currentUser.id ||
            record.accessRevoked
        )
    ) {

        showMessage(
            "downloadMessage",
            "Download denied.",
            false
        );

        return;
    }

    const encryptedFile = {

        application:
            "SecureMed",

        version:
            "Stage 7",

        recordId:
            record.recordId,

        patientId:
            record.patientId,

        authorizedDoctor:
            record.sharedWithDoctorId,

        encryptedData:
            record.ciphertext,

        salt:
            record.salt,

        iv:
            record.iv,

        status:
            "Encrypted",

        note:
            "This file contains encrypted ciphertext only. No plaintext medical record or passphrase is stored."
    };

    const json =
        JSON.stringify(
            encryptedFile,
            null,
            4
        );

    const blob =
        new Blob(
            [json],
            {
                type:
                    "application/json"
            }
        );

    const url =
        URL.createObjectURL(blob);

    const link =
        document.createElement("a");

    link.href = url;

    link.download =
        "SecureMed_" +
        record.patientId +
        "_" +
        record.recordId.substring(0,8) +
        ".json";

    document.body.appendChild(link);

    link.click();

    document.body.removeChild(link);

    URL.revokeObjectURL(url);

    if (
        document.getElementById(
            "downloadMessage"
        )
    ) {

        showMessage(
            "downloadMessage",
            "Encrypted record downloaded successfully.",
            true
        );
    }

    addAudit(
        currentUser.role.toUpperCase() +
        " " +
        currentUser.id +
        " downloaded encrypted record " +
        record.recordId.substring(0,12) +
        ".",
        true
    );
}


/* =====================================================
   TAMPER DETECTION
===================================================== */

function tamperSelectedRecord() {

    if (!selectedRecordId) {

        showMessage(
            "tamperMessage",
            "First select a record.",
            false
        );

        return;
    }

    const record =
        sharedRecords.find(
            r =>
                r.recordId ===
                selectedRecordId
        );

    if (!record) {

        showMessage(
            "tamperMessage",
            "Record not found.",
            false
        );

        return;
    }

    if (record.accessRevoked) {

        showMessage(
            "tamperMessage",
            "Cannot tamper with a revoked record.",
            false
        );

        return;
    }

    /* MODIFY ONE CHARACTER OF CIPHERTEXT */

    const ciphertext =
        record.ciphertext;

    const position =
        Math.floor(
            ciphertext.length / 2
        );

    const oldChar =
        ciphertext.charAt(position);

    const newChar =
        oldChar === "A"
        ? "B"
        : "A";

    record.ciphertext =
        ciphertext.substring(
            0,
            position
        ) +

        newChar +

        ciphertext.substring(
            position + 1
        );

    record.tampered = true;

    showMessage(
        "tamperMessage",
        "Ciphertext modified. Now try decrypting it from the Doctor dashboard. AES-GCM should detect the tampering.",
        true
    );

    updateServer(record);

    renderPatientRecords();

    addAudit(
        "Tamper simulation performed on record " +
        record.recordId.substring(0,12) +
        ". Ciphertext was intentionally modified.",
        false
    );

    alert(
        "Tampering simulated successfully.\n\n" +
        "Now login as the authorized doctor and try to decrypt the record.\n\n" +
        "AES-256-GCM should reject the modified ciphertext."
    );
}


