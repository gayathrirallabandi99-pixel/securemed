    });
}


/* =====================================================
   SELECT DOCTOR RECORD
===================================================== */

function selectRecord(recordId) {

    const record =
        sharedRecords.find(
            r => r.recordId === recordId
        );

    if (!record) return;

    if (
        record.sharedWithDoctorId !==
        currentUser.id
    ) {

        showMessage(
            "doctorMessage",
            "Access denied.",
            false
        );

        addAudit(
            "Unauthorized access attempt by Doctor " +
            currentUser.id +
            ".",
            false
        );

        return;
    }

    if (record.accessRevoked) {

        showMessage(
            "doctorMessage",
            "Access has been revoked by the patient.",
            false
        );

        addAudit(
            "Doctor " +
            currentUser.id +
            " attempted to access a revoked record.",
            false
        );

        return;
    }

    selectedRecordId = recordId;

    showMessage(
        "doctorMessage",
        "Record selected. Enter the passphrase.",
        true
    );

    addAudit(
        "Doctor " +
        currentUser.id +
        " selected authorized record " +
        recordId.substring(0, 12) +
        ".",
        true
    );
}


/* =====================================================
   DOCTOR DECRYPTION
===================================================== */

async function decryptSelectedRecord() {

    if (!selectedRecordId) {

        showMessage(
            "doctorMessage",
            "Please select a record first.",
            false
        );

        return;
    }

    const passphrase =
        document
        .getElementById("doctorPassphrase")
        .value;

    if (!passphrase) {

        showMessage(
            "doctorMessage",
            "Please enter the passphrase.",
            false
        );

        return;
    }

    const record =
        sharedRecords.find(
            r =>
                r.recordId ===
                selectedRecordId
        );

    if (!record) {

        showMessage(
            "doctorMessage",
            "Record not found.",
            false
        );

        return;
    }

    if (
        record.sharedWithDoctorId !==
        currentUser.id
    ) {

        failedAttemptCount++;

        updateFailedAttempts();

        showMessage(
            "doctorMessage",
            "Access denied.",
            false
        );

        return;
    }

    if (record.accessRevoked) {

        failedAttemptCount++;

        updateFailedAttempts();

        showMessage(
            "doctorMessage",
            "Access has been revoked by the patient.",
            false
        );

        addAudit(
            "Doctor " +
            currentUser.id +
            " attempted to decrypt a revoked record.",
            false
        );

        return;
    }

    try {

        const decrypted =
            await decryptRecord(
                record,
                passphrase
            );

        document.getElementById(
            "decPatientId"
        ).textContent =
            decrypted.patientId;

        document.getElementById(
            "decPatientName"
        ).textContent =
            decrypted.patientName;

        document.getElementById(
            "decDiagnosis"
        ).textContent =
            decrypted.diagnosis;

        document.getElementById(
            "decPrescription"
        ).textContent =
            decrypted.prescription;

        document.getElementById(
            "decHistory"
        ).textContent =
            decrypted.history;

        document
            .getElementById("decryptedSection")
            .classList
            .remove("hidden");

        record.status = "Decrypted";

        showMessage(
            "doctorMessage",
            "Decryption successful. Data integrity verified.",
            true
        );

        addAudit(
            "Doctor " +
            currentUser.id +
            " successfully decrypted Patient " +
            decrypted.patientId +
            "'s record. AES-GCM integrity check passed.",
            true
        );

    } catch (error) {

        failedAttemptCount++;

        updateFailedAttempts();

        document
            .getElementById("decryptedSection")
            .classList
            .add("hidden");

        showMessage(
            "doctorMessage",
            "Decryption failed. Wrong passphrase or data has been tampered with.",
            false
        );

        addAudit(
            "Decryption failed for Doctor " +
            currentUser.id +
            ". Possible wrong password or tampering detected.",
            false
        );
    }
}


