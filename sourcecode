<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SecureMed - Stage 7</title>
<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #1e293b;
}

/* LOGIN */

.login-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #0f172a, #1d4ed8);
}

.login-box {
    width: 400px;
    background: white;
    padding: 35px;
    border-radius: 18px;
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
}

.logo {
    text-align: center;
    margin-bottom: 25px;
}

.logo h1 {
    color: #2563eb;
    font-size: 32px;
}

.logo p {
    color: #64748b;
    margin-top: 5px;
}

.login-box h2 {
    text-align: center;
    margin-bottom: 20px;
}

label {
    display: block;
    font-weight: bold;
    font-size: 14px;
    margin: 12px 0 6px;
}

input,
textarea,
select {
    width: 100%;
    padding: 11px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
}

input:focus,
textarea:focus,
select:focus {
    border-color: #2563eb;
}

textarea {
    min-height: 90px;
    resize: vertical;
}

.primary-btn,
.action-btn {
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
    font-weight: bold;
    margin-top: 12px;
}

.primary-btn {
    width: 100%;
    background: #2563eb;
    color: white;
    margin-top: 20px;
}

.primary-btn:hover,
.action-btn:hover {
    background: #1d4ed8;
}

.action-btn {
    background: #2563eb;
    color: white;
}

.danger-btn {
    background: #dc2626;
}

.danger-btn:hover {
    background: #b91c1c;
}

.secondary-btn {
    background: #475569;
    color: white;
}

.secondary-btn:hover {
    background: #334155;
}

/* APPLICATION */

.app {
    display: none;
    min-height: 100vh;
}

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    bottom: 0;
    width: 240px;
    background: #0f172a;
    color: white;
    padding: 25px 18px;
}

.sidebar-logo {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 35px;
    padding-left: 10px;
}

.sidebar-logo span {
    color: #60a5fa;
}

.nav-item {
    padding: 13px;
    margin: 7px 0;
    border-radius: 8px;
    color: #cbd5e1;
}

.nav-item.active,
.nav-item:hover {
    background: #1e40af;
    color: white;
}

.logout {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 25px;
    background: #dc2626;
    padding: 12px;
    text-align: center;
    border-radius: 8px;
    cursor: pointer;
}

.main {
    margin-left: 240px;
    padding: 30px;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.topbar h1 {
    font-size: 28px;
}

.topbar p {
    color: #64748b;
    margin-top: 5px;
}

.user-badge {
    background: white;
    padding: 10px 18px;
    border-radius: 20px;
    box-shadow: 0 3px 12px rgba(0,0,0,.08);
    font-weight: bold;
}

/* STATS */

.stats {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.stat-card {
    background: white;
    padding: 20px;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(0,0,0,.06);
}

.stat-card h4 {
    color: #64748b;
    font-size: 13px;
    margin-bottom: 10px;
}

.number {
    font-size: 23px;
    font-weight: bold;
}

.blue { color: #2563eb; }
.green { color: #16a34a; }
.orange { color: #ea580c; }
.red { color: #dc2626; }
.purple { color: #7c3aed; }

/* CARDS */

.grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 22px;
}

.card {
    background: white;
    padding: 23px;
    border-radius: 14px;
    box-shadow: 0 5px 18px rgba(0,0,0,.06);
    margin-bottom: 22px;
}

.card h2 {
    font-size: 19px;
    margin-bottom: 17px;
}

/* SECURITY */

.security-grid {
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 12px;
}

.security-item {
    background: #f8fafc;
    padding: 14px;
    border-radius: 10px;
    border-left: 4px solid #2563eb;
}

.security-item strong {
    display: block;
    margin-bottom: 5px;
}

.security-item span {
    color: #64748b;
    font-size: 12px;
}

/* RECORD */

.record-box {
    background: #f8fafc;
    padding: 16px;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    margin-top: 12px;
}

.record-box p {
    margin: 8px 0;
    font-size: 14px;
}

.record-box strong {
    color: #334155;
}

/* STATUS */

.status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.status.shared {
    background: #dcfce7;
    color: #166534;
}

.status.revoked {
    background: #fee2e2;
    color: #991b1b;
}

.status.decrypted {
    background: #dbeafe;
    color: #1d4ed8;
}

.status.authorized {
    background: #dcfce7;
    color: #166534;
}

.status.tampered {
    background: #fee2e2;
    color: #991b1b;
}

/* FLOW */

.flow {
    display: flex;
    align-items: center;
    gap: 8px;
}

.flow-step {
    flex: 1;
    padding: 16px 8px;
    background: #eff6ff;
    text-align: center;
    border-radius: 10px;
    font-size: 12px;
    font-weight: bold;
}

.arrow {
    color: #2563eb;
    font-size: 20px;
}

/* SERVER */

.server-box {
    background: #0f172a;
    color: #22c55e;
    padding: 17px;
    border-radius: 10px;
    font-family: monospace;
    font-size: 12px;
    line-height: 1.7;
    overflow-wrap: anywhere;
}

.server-title {
    color: white;
    font-family: Arial;
    margin-bottom: 10px;
}

/* MESSAGES */

.message {
    display: none;
    padding: 11px;
    border-radius: 8px;
    margin-top: 12px;
    font-size: 13px;
}

.success {
    background: #dcfce7;
    color: #166534;
}

.error {
    background: #fee2e2;
    color: #991b1b;
}

/* AUDIT */

.audit {
    border-left: 4px solid #2563eb;
    padding: 10px 14px;
    margin-bottom: 10px;
    background: #f8fafc;
    border-radius: 6px;
}

.audit.success-log {
    border-left-color: #16a34a;
}

.audit.error-log {
    border-left-color: #dc2626;
}

.audit small {
    color: #64748b;
}

/* INFO */

.info-box {
    background: #eff6ff;
    border-left: 4px solid #2563eb;
    padding: 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
}

.warning-box {
    background: #fff7ed;
    border-left: 4px solid #ea580c;
    padding: 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
}

.success-box {
    background: #f0fdf4;
    border-left: 4px solid #16a34a;
    padding: 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.6;
}

.hidden {
    display: none !important;
}

.button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
}

.button-row .action-btn {
    margin-top: 0;
}

.small-text {
    color: #64748b;
    font-size: 12px;
    margin-top: 8px;
}

/* RESPONSIVE */

@media(max-width:1000px) {
    .stats {
        grid-template-columns: repeat(2,1fr);
    }

    .grid {
        grid-template-columns: 1fr;
    }
}

@media(max-width:700px) {
    .sidebar {
        position: relative;
        width: 100%;
        height: auto;
    }

    .logout {
        position: static;
        margin-top: 20px;
    }

    .main {
        margin-left: 0;
        padding: 18px;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .flow {
        flex-direction: column;
    }

    .arrow {
        transform: rotate(90deg);
    }
}
</style>
</head>

<body>

<!-- =====================================================
     LOGIN
===================================================== -->

<div id="loginPage" class="login-page">

    <div class="login-box">

        <div class="logo">
            <h1>SecureMed</h1>
            <p>Cryptographic Medical Record System</p>
        </div>

        <h2>Secure Login</h2>

        <label>Username</label>

        <input
            type="text"
            id="username"
            placeholder="Enter username"
        >

        <label>Password</label>

        <input
            type="password"
            id="password"
            placeholder="Enter password"
        >

        <button
            class="primary-btn"
            onclick="login()"
        >
            Login
        </button>

        <div id="loginMessage" class="message error"></div>

    </div>
</div>


<!-- =====================================================
     APPLICATION
===================================================== -->

<div id="app" class="app">

    <aside class="sidebar">

        <div class="sidebar-logo">
            Secure<span>Med</span>
        </div>

        <div class="nav-item active">
            Dashboard
        </div>

        <div class="nav-item">
            Medical Records
        </div>

        <div class="nav-item">
            Encryption
        </div>

        <div class="nav-item">
            Access Control
        </div>

        <div class="nav-item">
            Audit Log
        </div>

        <div class="logout" onclick="logout()">
            Logout
        </div>

    </aside>


    <main class="main">

        <div class="topbar">

            <div>
                <h1 id="dashboardTitle">
                    Dashboard
                </h1>

                <p>
                    Secure medical record management
                </p>
            </div>

            <div id="userBadge" class="user-badge">
                USER
            </div>

        </div>


        <!-- =================================================
             PATIENT DASHBOARD
        ================================================== -->

        <div id="patientDashboard">

            <div class="stats">

                <div class="stat-card">
                    <h4>Patient ID</h4>
                    <div
                        id="patientIdDisplay"
                        class="number blue"
                    >
                        P001
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Encryption</h4>
                    <div class="number purple">
                        AES-256-GCM
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Records Shared</h4>
                    <div
                        id="sharedCount"
                        class="number green"
                    >
                        0
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Access Revoked</h4>
                    <div
                        id="revokedCount"
                        class="number red"
                    >
                        0
                    </div>
                </div>

            </div>


            <div class="grid">

                <div>

                    <!-- CREATE RECORD -->

                    <div class="card">

                        <h2>
                            Create Medical Record
                        </h2>

                        <label>Patient ID</label>

                        <input
                            id="patientId"
                            readonly
                        >

                        <label>Patient Name</label>

                        <input
                            id="patientName"
                            placeholder="Enter dummy patient name"
                        >

                        <label>Diagnosis</label>

                        <input
                            id="diagnosis"
                            placeholder="Example: Common cold"
                        >

                        <label>Prescription</label>

                        <textarea
                            id="prescription"
                            placeholder="Enter dummy prescription"
                        ></textarea>

                        <label>Medical History</label>

                        <textarea
                            id="history"
                            placeholder="Enter dummy medical history"
                        ></textarea>

                    </div>


                    <!-- SECURE SHARING -->

                    <div class="card">

                        <h2>
                            Secure Sharing
                        </h2>

                        <label>
                            Select Doctor
                        </label>

                        <select id="doctorId">

                            <option value="D001">
                                D001 - Doctor 1
                            </option>

                            <option value="D002">
                                D002 - Doctor 2
                            </option>

                            <option value="D003">
                                D003 - Doctor 3
                            </option>

                        </select>

                        <label>
                            Secret Passphrase
                        </label>

                        <input
                            type="password"
                            id="patientPassphrase"
                            placeholder="Create a secret passphrase"
                        >

                        <button
                            class="action-btn"
                            onclick="encryptAndShare()"
                        >
                            Encrypt and Share
                        </button>

                        <div
                            id="patientMessage"
                            class="message"
                        ></div>

                    </div>


                    <!-- PATIENT RECORDS -->

                    <div class="card">

                        <h2>
                            My Shared Records
                        </h2>

                        <div id="patientRecords">
                            No records shared yet.
                        </div>

                    </div>

                </div>


                <div>

                    <!-- SECURITY -->

                    <div class="card">

                        <h2>
                            Security Architecture
                        </h2>

                        <div class="security-grid">

                            <div class="security-item">
                                <strong>AES-256</strong>
                                <span>
                                    256-bit encryption
                                </span>
                            </div>

                            <div class="security-item">
                                <strong>GCM Mode</strong>
                                <span>
                                    Authentication tag
                                </span>
                            </div>

                            <div class="security-item">
                                <strong>Random IV</strong>
                                <span>
                                    Unique encryption IV
                                </span>
                            </div>

                            <div class="security-item">
                                <strong>PBKDF2</strong>
                                <span>
                                    SHA-256 key derivation
                                </span>
                            </div>

                        </div>

                    </div>


                    <!-- ACCESS CONTROL -->

                    <div class="card">

                        <h2>
                            Access Control
                        </h2>

                        <div class="info-box">

                            A record can only be accessed
                            by the doctor selected by
                            the patient.

                        </div>

                        <br>

                        <div class="success-box">

                            Revoke Access can immediately
                            disable the selected doctor's
                            access to a shared record.

                        </div>

                    </div>


                    <!-- ENCRYPTION FLOW -->

                    <div class="card">

                        <h2>
                            Encryption Flow
                        </h2>

                        <div class="flow">

                            <div class="flow-step">
                                Medical Record
                            </div>

                            <div class="arrow">
                                >
                            </div>

                            <div class="flow-step">
                                AES-256-GCM
                            </div>

                            <div class="arrow">
                                >
                            </div>

                            <div class="flow-step">
                                Ciphertext
                            </div>

                            <div class="arrow">
                                >
                            </div>

                            <div class="flow-step">
                                Secure Storage
                            </div>

                        </div>

                    </div>


                    <!-- SERVER -->

                    <div class="card">

                        <h2>
                            Secure Server Simulation
                        </h2>

                        <div class="server-box">

                            <div class="server-title">
                                ENCRYPTED STORAGE
                            </div>

                            <div id="serverOutput">
                                No encrypted record stored.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- TAMPER DEMO -->

            <div class="card">

                <h2>
                    Tamper Detection Demonstration
                </h2>

                <div class="warning-box">

                    This demonstration intentionally
                    modifies the encrypted ciphertext.
                    AES-GCM should detect the modification
                    and reject decryption.

                </div>

                <button
                    class="action-btn danger-btn"
                    onclick="tamperSelectedRecord()"
                >
                    Simulate Data Tampering
                </button>

                <div
                    id="tamperMessage"
                    class="message"
                ></div>

            </div>

        </div>


        <!-- =================================================
             DOCTOR DASHBOARD
        ================================================== -->

        <div id="doctorDashboard" class="hidden">

            <div class="stats">

                <div class="stat-card">
                    <h4>Doctor ID</h4>
                    <div
                        id="doctorIdDisplay"
                        class="number blue"
                    >
                        D001
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Access Control</h4>
                    <div class="number green">
                        ACTIVE
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Available Records</h4>
                    <div
                        id="doctorRecordCount"
                        class="number purple"
                    >
                        0
                    </div>
                </div>

                <div class="stat-card">
                    <h4>Failed Attempts</h4>
                    <div
                        id="failedAttempts"
                        class="number red"
                    >
                        0
                    </div>
                </div>

            </div>


            <!-- RECORDS -->

            <div class="card">

                <h2>
                    Records Shared With Me
                </h2>

                <div id="doctorRecords">
                    No records shared with you.
                </div>

            </div>


            <!-- DECRYPT -->

            <div class="card">

                <h2>
                    Secure Decryption
                </h2>

                <div class="info-box">

                    Select an authorized record,
                    then enter the secret passphrase
                    created by the patient.

                </div>

                <label>
                    Secret Passphrase
                </label>

                <input
                    type="password"
                    id="doctorPassphrase"
                    placeholder="Enter patient passphrase"
                >

                <div class="button-row">

                    <button
                        class="action-btn"
                        onclick="decryptSelectedRecord()"
                    >
                        Decrypt Record
                    </button>

                    <button
                        class="action-btn secondary-btn"
                        onclick="clearDecryptedRecord()"
                    >
                        Clear
                    </button>

                </div>

                <div
                    id="doctorMessage"
                    class="message"
                ></div>

            </div>


            <!-- DECRYPTED -->

            <div
                id="decryptedSection"
                class="card hidden"
            >

                <h2>
                    Decrypted Medical Record
                </h2>

                <div class="record-box">

                    <p>
                        <strong>Patient ID:</strong>
                        <span id="decPatientId"></span>
                    </p>

                    <p>
                        <strong>Patient Name:</strong>
                        <span id="decPatientName"></span>
                    </p>

                    <p>
                        <strong>Diagnosis:</strong>
                        <span id="decDiagnosis"></span>
                    </p>

                    <p>
                        <strong>Prescription:</strong>
                        <span id="decPrescription"></span>
                    </p>

                    <p>
                        <strong>Medical History:</strong>
                        <span id="decHistory"></span>
                    </p>

                </div>

            </div>


            <!-- DOWNLOAD -->

            <div class="card">

                <h2>
                    Encrypted File
                </h2>

                <div class="info-box">

                    Only encrypted data can be
                    downloaded. The plaintext medical
                    record and passphrase are never
                    included in the downloaded file.

                </div>

                <button
                    class="action-btn"
                    onclick="downloadSelectedRecord()"
                >
                    Download Encrypted Record
                </button>

                <div
                    id="downloadMessage"
                    class="message"
                ></div>

            </div>


            <!-- DECRYPTION FLOW -->

            <div class="card">

                <h2>
                    Decryption Flow
                </h2>

                <div class="flow">

                    <div class="flow-step">
                        Ciphertext
                    </div>

                    <div class="arrow">
                        >
                    </div>

                    <div class="flow-step">
                        Passphrase
                    </div>

                    <div class="arrow">
                        >
                    </div>

                    <div class="flow-step">
                        AES-256-GCM
                    </div>

                    <div class="arrow">
                        >
                    </div>

                    <div class="flow-step">
                        Medical Record
                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             AUDIT LOG
        ================================================== -->

        <div class="card">

            <h2>
                Security Audit Log
            </h2>

            <div
                id="auditLog"
            >
                <div class="audit">
                    <strong>
                        System initialized
                    </strong>
                    <br>
                    <small>
                        SecureMed Stage 7 started
                    </small>
                </div>
            </div>

        </div>


        <div
            style="
            text-align:center;
            color:#64748b;
            font-size:12px;
            margin-top:25px;
            "
        >
            SecureMed - Cryptography PBL Project
        </div>

    </main>

</div>


<script>

/* =====================================================
   USER DATABASE
   Hidden from login screen
===================================================== */

const users = {

    patient1: {
        username: "patient1",
        password: "1234",
        role: "patient",
        id: "P001"
    },

    patient2: {
        username: "patient2",
        password: "2345",
        role: "patient",
        id: "P002"
    },

    patient3: {
        username: "patient3",
        password: "3456",
        role: "patient",
        id: "P003"
    },

    patient4: {
        username: "patient4",
        password: "4567",
        role: "patient",
        id: "P004"
    },

    doctor1: {
        username: "doctor1",
        password: "5678",
        role: "doctor",
        id: "D001"
    },

    doctor2: {
        username: "doctor2",
        password: "6789",
        role: "doctor",
        id: "D002"
    },

    doctor3: {
        username: "doctor3",
        password: "7890",
        role: "doctor",
        id: "D003"
    }

};


/* =====================================================
   VARIABLES
===================================================== */

let currentUser = null;

let sharedRecords = [];

let selectedRecordId = null;

let failedAttemptCount = 0;


/* =====================================================
   LOGIN
===================================================== */

function login() {

    const username =
        document.getElementById("username").value.trim();

    const password =
        document.getElementById("password").value;

    const message =
        document.getElementById("loginMessage");

    let loggedInUser = null;

    for (const key in users) {

        const user = users[key];

        if (
            username === user.username &&
            password === user.password
        ) {
            loggedInUser = user;
            break;
        }
    }

    if (!loggedInUser) {

        message.style.display = "block";

        message.textContent =
            "Invalid username or password.";

        addAudit(
            "Failed login attempt for username: " +
            username,
            false
        );

        return;
    }

    currentUser = loggedInUser;

    message.style.display = "none";

    openDashboard();
}


/* =====================================================
   DASHBOARD
===================================================== */

function openDashboard() {

    document.getElementById("loginPage").style.display = "none";

    document.getElementById("app").style.display = "block";

    document.getElementById("userBadge").textContent =
        currentUser.role.toUpperCase() +
        " - " +
        currentUser.id;

    if (currentUser.role === "patient") {

        document
            .getElementById("patientDashboard")
