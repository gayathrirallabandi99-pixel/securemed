/* =====================================================
   ARRAY BUFFER -> BASE64
===================================================== */

function arrayBufferToBase64(buffer) {

    let binary = "";

    const bytes = new Uint8Array(buffer);

    for (let i = 0; i < bytes.length; i++) {

        binary += String.fromCharCode(bytes[i]);
    }

    return btoa(binary);
}


/* =====================================================
   BASE64 -> ARRAY BUFFER
===================================================== */

function base64ToArrayBuffer(base64) {

    const binary = atob(base64);

    const bytes = new Uint8Array(binary.length);

    for (let i = 0; i < binary.length; i++) {

        bytes[i] = binary.charCodeAt(i);
    }

    return bytes.buffer;
}


/* =====================================================
   PBKDF2 KEY DERIVATION
===================================================== */

async function deriveKey(passphrase, salt) {

    const encoder = new TextEncoder();

    const passwordKey =
        await crypto.subtle.importKey(
            "raw",
            encoder.encode(passphrase),
            {
                name: "PBKDF2"
            },
            false,
            ["deriveKey"]
        );

    return crypto.subtle.deriveKey(

        {
            name: "PBKDF2",
            salt: salt,
            iterations: 100000,
            hash: "SHA-256"
        },

        passwordKey,

        {
            name: "AES-GCM",
            length: 256
        },

        false,

        [
            "encrypt",
            "decrypt"
        ]
    );
}


/* =====================================================
   AES ENCRYPTION
===================================================== */

async function encryptRecord(record, passphrase) {

    const encoder = new TextEncoder();

    const salt =
        crypto.getRandomValues(
            new Uint8Array(16)
        );

    const iv =
        crypto.getRandomValues(
            new Uint8Array(12)
        );

    const key =
        await deriveKey(
            passphrase,
            salt
        );

    const data =
        encoder.encode(
            JSON.stringify(record)
        );

    const encrypted =
        await crypto.subtle.encrypt(

            {
                name: "AES-GCM",
                iv: iv
            },

            key,

            data
        );

    return {

        ciphertext:
            arrayBufferToBase64(encrypted),

        salt:
            arrayBufferToBase64(salt),

        iv:
            arrayBufferToBase64(iv)
    };
}


/* =====================================================
   AES DECRYPTION
===================================================== */

async function decryptRecord(
    packageData,
    passphrase
) {

    const salt =
        new Uint8Array(
            base64ToArrayBuffer(
                packageData.salt
            )
        );

    const iv =
        new Uint8Array(
            base64ToArrayBuffer(
                packageData.iv
            )
        );

    const encrypted =
        base64ToArrayBuffer(
            packageData.ciphertext
        );

    const key =
        await deriveKey(
            passphrase,
            salt
        );

    const decrypted =
        await crypto.subtle.decrypt(

            {
                name: "AES-GCM",
                iv: iv
            },

            key,

            encrypted
        );

    const decoder = new TextDecoder();

    return JSON.parse(
        decoder.decode(decrypted)
    );
}


/* =====================================================
   ENCRYPT AND SHARE
===================================================== */

async function encryptAndShare() {

    if (!currentUser ||
        currentUser.role !== "patient") {
        return;
    }

    const patientName =
        document
        .getElementById("patientName")
        .value.trim();

    const diagnosis =
        document
        .getElementById("diagnosis")
        .value.trim();

    const prescription =
        document
        .getElementById("prescription")
        .value.trim();

    const history =
        document
        .getElementById("history")
        .value.trim();

    const doctorId =
        document
        .getElementById("doctorId")
        .value;

    const passphrase =
        document
        .getElementById("patientPassphrase")
        .value;

    if (
        !patientName ||
        !diagnosis ||
        !prescription ||
        !history ||
        !passphrase
    ) {

        showMessage(
            "patientMessage",
            "Please fill all fields.",
            false
        );

        return;
    }

    const record = {

        patientId: currentUser.id,

        patientName: patientName,

        diagnosis: diagnosis,

        prescription: prescription,

        history: history
    };

    try {

        const encrypted =
            await encryptRecord(
                record,
                passphrase
            );

        const recordId =
            typeof crypto.randomUUID === "function"
            ?
            crypto.randomUUID()
            :
            Date.now() +
            "-" +
            Math.random();

        const packageData = {

            recordId: recordId,

            patientId: currentUser.id,

            sharedWithDoctorId: doctorId,

            ciphertext: encrypted.ciphertext,

            salt: encrypted.salt,

            iv: encrypted.iv,

            sharedAt:
                new Date().toLocaleString(),

            status: "Shared",

            accessRevoked: false,

            tampered: false
        };

        sharedRecords.push(packageData);

        selectedRecordId = recordId;

        updatePatientStats();

        updateServer(packageData);

        renderPatientRecords();

        showMessage(
            "patientMessage",
            "Record encrypted and shared with Doctor " +
            doctorId + ".",
            true
        );

        addAudit(
            "Patient " +
            currentUser.id +
            " encrypted a medical record using AES-256-GCM and shared it with Doctor " +
            doctorId +
            ".",
            true
        );

        document.getElementById("patientName").value = "";
        document.getElementById("diagnosis").value = "";
        document.getElementById("prescription").value = "";
        document.getElementById("history").value = "";
        document.getElementById("patientPassphrase").value = "";

    } catch (error) {

        console.error(error);

        showMessage(
            "patientMessage",
            "Encryption failed.",
            false
        );
    }
}


/* =====================================================
   PATIENT STATISTICS
===================================================== */

function updatePatientStats() {

    if (!currentUser) return;

    const records =
        sharedRecords.filter(
            record =>
                record.patientId ===
                currentUser.id
        );

    const revoked =
        records.filter(
            record =>
                record.accessRevoked
        ).length;

    document.getElementById("sharedCount").textContent =
        records.length;

    document.getElementById("revokedCount").textContent =
        revoked;
}


/* =====================================================
   RENDER PATIENT RECORDS
===================================================== */

function renderPatientRecords() {

    const container =
        document.getElementById(
            "patientRecords"
        );

    const records =
        sharedRecords.filter(
            record =>
                record.patientId ===
                currentUser.id
        );

    updatePatientStats();

    if (records.length === 0) {

        container.innerHTML =
            "No records shared yet.";

        return;
    }

    container.innerHTML = "";

    records.forEach(record => {

        const div =
            document.createElement("div");

        div.className = "record-box";

        let statusHTML;

        if (record.accessRevoked) {

            statusHTML =
                '<span class="status revoked">' +
                'ACCESS REVOKED' +
                '</span>';

        } else if (record.tampered) {

            statusHTML =
                '<span class="status tampered">' +
                'TAMPERED' +
                '</span>';

        } else if (record.status === "Decrypted") {

            statusHTML =
                '<span class="status decrypted">' +
                'DECRYPTED' +
                '</span>';

        } else {

            statusHTML =
                '<span class="status shared">' +
                'SHARED' +
                '</span>';
        }

        div.innerHTML =

            "<p>" +
            "<strong>Record ID:</strong> " +
            escapeHTML(
                record.recordId.substring(0, 12)
            ) +
            "</p>" +

            "<p>" +
            "<strong>Patient ID:</strong> " +
            escapeHTML(record.patientId) +
            "</p>" +

            "<p>" +
            "<strong>Doctor:</strong> " +
            escapeHTML(
                record.sharedWithDoctorId
            ) +
            "</p>" +

            "<p>" +
            "<strong>Shared At:</strong> " +
            escapeHTML(record.sharedAt) +
            "</p>" +

            "<p>" +
            "<strong>Status:</strong> " +
            statusHTML +
            "</p>";

        if (!record.accessRevoked) {

            div.innerHTML +=

                '<div class="button-row">' +

                '<button class="action-btn danger-btn" ' +
                'onclick="revokeAccess(\'' +
                record.recordId +
                '\')">' +
                'Revoke Access' +
                '</button>' +

                '<button class="action-btn secondary-btn" ' +
                'onclick="selectPatientRecord(\'' +
                record.recordId +
                '\')">' +
                'Select' +
                '</button>' +

                '</div>';
        }

        container.appendChild(div);
    });
}


/* =====================================================
   SELECT PATIENT RECORD
===================================================== */

function selectPatientRecord(recordId) {

    const record =
        sharedRecords.find(
            r => r.recordId === recordId
        );

    if (!record) return;

    selectedRecordId = recordId;

    showMessage(
        "tamperMessage",
        "Record selected for security testing.",
        true
    );
}


/* =====================================================
   REVOKE ACCESS
===================================================== */

function revokeAccess(recordId) {

    const record =
        sharedRecords.find(
            r => r.recordId === recordId
        );

    if (!record) return;

    if (record.patientId !== currentUser.id) {

        addAudit(
            "Unauthorized revoke attempt.",
            false
        );

        return;
    }

    if (record.accessRevoked) {

        showMessage(
            "patientMessage",
            "Access is already revoked.",
            false
        );

        return;
    }

    const confirmed =
        confirm(
            "Revoke Doctor " +
            record.sharedWithDoctorId +
            " access to this record?"
        );

    if (!confirmed) return;

    record.accessRevoked = true;

    record.status = "Revoked";

    if (selectedRecordId === recordId) {

        selectedRecordId = null;
    }

    renderPatientRecords();

    updatePatientStats();

    showMessage(
        "patientMessage",
        "Access successfully revoked.",
        true
    );

    addAudit(
        "Patient " +
        currentUser.id +
        " revoked access for Doctor " +
        record.sharedWithDoctorId +
        " on record " +
        recordId.substring(0, 12) +
        ".",
        true
    );
}


